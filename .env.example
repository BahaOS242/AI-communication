# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentforge"

# --- Mode -----------------------------------------------------------------
# DEMO_MODE=true runs the full orchestration loop with a deterministic scripted
# AI provider and a labelled demo dataset. No API keys required.
DEMO_MODE=true
# Artificial delay between demo agent steps so the live view is watchable.
DEMO_STEP_DELAY_MS=900

# --- AI provider (ignored when DEMO_MODE=true) ------------------------------
# anthropic | openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Search tool ------------------------------------------------------------
# If neither key is set, the clearly-labelled demo dataset is used.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- Loop protection --------------------------------------------------------
MAX_ITERATIONS=10
MAX_AGENT_CALLS=30
MAX_RETRIES=2
AGENT_TIMEOUT_MS=120000
TASK_TIMEOUT_MS=900000

# debug | info | warn | error
LOG_LEVEL=info
